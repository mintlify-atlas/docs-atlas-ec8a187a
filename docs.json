  "name": "MVC PHP",
  "theme": "mint",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4338ca"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/dogiloki/mvc-php"
    }
  },
  "footer": {

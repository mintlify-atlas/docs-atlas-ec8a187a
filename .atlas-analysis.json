  "keyFeatures": [
    "MVC architecture with controller, model, and view separation",
    "Fluent routing system with named routes, route groups, and parameter support",
    "Eloquent-inspired ORM with hasOne, hasMany, and manyToMany relationships",
    "SQL query builder with joins, pagination, and raw expressions",
    "Database migrations and schema builder",
    "Middleware pipeline for request/response lifecycle",
    "Built-in authentication system (DB, PAM, API tokens)",
    "WebSocket server inspired by Socket.io",
    "HTTP client (Guzzle-powered) and request/response abstraction",
    "SCSS compilation, QR code generation, spreadsheet export, image manipulation",
    "CLI console system for custom commands",
    "Environment-based configuration via config.env"
  ],
  "publicApiSurface": [
    "Route::get($path, $action)",
    "Route::post($path, $action)",
    "Route::put($path, $action)",
    "Route::delete($path, $action)",
    "Route::group($prefix, $callback)",
    "Route::middleware($middleware)",
    "Model::find($id)",
    "Model::all()",
    "Model::create($data)",
    "Model::where($column, $value)",
    "Model::paginate($perPage)",
    "Model::search($text)",
    "Model::with($relations)",
    "Model->save()",
    "Model->update($data)",
    "Model->delete()",
    "Model->hasOne($table, $fk)",
    "Model->hasMany($table, $fk)",
    "Model->manyToMany($table, $pivot, $fk1, $fk2)",
    "DB::table($table)",
    "DB::execute($sql)",
    "DB::flat($expression)",
    "Schema::table($name, $callback)",
    "Schema::tableIfNotExists($name, $callback)",
    "Schema::dropIfExists($table)",
    "Auth::login($credentials)",
    "Auth::user()",
    "Auth::logout()",
    "Session::get($key)",
    "Session::set($key, $value)",
    "view($template, $data)",
    "env($key, $default)",
    "Config::get($key)"
  ]
}
